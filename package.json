{
  "name": "kong-portal-cli",
  "version": "3.6.3",
  "description": "CLI tool to manage your Kong Developer Portals for Kong Enterprise",
  "main": "index.js",
  "bin": {
    "portal": "./bin/src/portal.js"
  },
  "scripts": {
    "test": "tap",
    "test:ci": "tap --coverage-report=lcovonly",
    "lint": "eslint --ext .ts ./src",
    "lint:fix": "eslint --ext .ts ./src --fix",
    "build": "rm -rf bin && tsc && chmod +x ./bin/src/portal.js",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kong/kong-portal-cli.git"
  },
  "keywords": [
    "cli",
    "kong",
    "developer",
    "portal",
    "kong-developer-portal",
    "kong-portal-cli"
  ],
  "author": "Nijiko Yonskai @nijikokun",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/Kong/kong-portal-cli/issues"
  },
  "homepage": "https://github.com/Kong/kong-portal-cli#readme",
  "dependencies": {
    "axios": "^1.20.0",
    "chokidar": "^4.0.3",
    "clipanion": "^2.3.1",
    "crypto-promise": "^2.1.0",
    "fs-extra": "^11.4.0",
    "isbinaryfile": "^4.0.3",
    "js-yaml": "^4.3.2",
    "ora": "^5.4.1",
    "recursive-readdir-async": "^1.2.1",
    "upath": "^1.2.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.19.0",
    "@typescript-eslint/eslint-plugin": "^5.30.5",
    "@typescript-eslint/parser": "^5.8.0",
    "eslint": "^8.19.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-prettier": "^4.2.1",
    "prettier": "^2.7.1",
    "tap": "^21.1.0",
    "ts-node": "^10.8.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "tap": {
    "allow-incomplete-coverage": true
  }
}
